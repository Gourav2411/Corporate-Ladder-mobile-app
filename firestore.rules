rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function isValidUserProfile(data) {
      return data.keys().hasAny(['displayName', 'createdAt', 'highestScore_endless', 'highestScore_championship', 'highestScore_takeover', 'highestScore_quiet', 'lifetimeSynergy', 'unlockedSkills']) &&
             data.get('displayName', '') is string && data.get('displayName', '').size() <= 100 &&
             (data.keys().hasAll(['avatarId']) ? data.avatarId is string && data.avatarId.size() <= 50 : true) &&
             (data.keys().hasAll(['highestScore_endless']) ? data.highestScore_endless is number : true) &&
             (data.keys().hasAll(['highestScore_championship']) ? data.highestScore_championship is number : true) &&
             (data.keys().hasAll(['highestScore_takeover']) ? data.highestScore_takeover is number : true) &&
             (data.keys().hasAll(['highestScore_quiet']) ? data.highestScore_quiet is number : true) &&
             (data.keys().hasAll(['lifetimeSynergy']) ? data.lifetimeSynergy is number : true) &&
             (data.keys().hasAll(['unlockedSkills']) ? data.unlockedSkills is list && data.unlockedSkills.size() <= 50 : true) &&
             (data.keys().hasAll(['achievements']) ? data.achievements is list && data.achievements.size() <= 100 : true);
    }

    match /users/{userId} {
      allow read: if isSignedIn(); // Basic profiles needed for game UI maybe, or just owner
      allow create: if isOwner(userId) && 
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) && 
                       incoming().keys().hasAll(['displayName', 'createdAt']) && 
                       incoming().createdAt == request.time;
      allow update: if isOwner(userId) && 
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       // Must only modify allowed fields
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarId', 'highestScore_endless', 'highestScore_championship', 'highestScore_takeover', 'highestScore_quiet', 'lifetimeSynergy', 'unlockedSkills', 'achievements', 'streakCount', 'streakLastDay', 'seasonWins', 'bountyEscrow', 'currentCompanyId', 'currentCompanyName']) &&
                       // High scores can only go up
                       (incoming().diff(existing()).affectedKeys().hasAny(['highestScore_endless']) ? incoming().get('highestScore_endless', 0) >= existing().get('highestScore_endless', 0) : true) &&
                       (incoming().diff(existing()).affectedKeys().hasAny(['highestScore_championship']) ? incoming().get('highestScore_championship', 0) >= existing().get('highestScore_championship', 0) : true) &&
                       (incoming().diff(existing()).affectedKeys().hasAny(['highestScore_takeover']) ? incoming().get('highestScore_takeover', 0) >= existing().get('highestScore_takeover', 0) : true) &&
                       (incoming().diff(existing()).affectedKeys().hasAny(['highestScore_quiet']) ? incoming().get('highestScore_quiet', 0) >= existing().get('highestScore_quiet', 0) : true);
    }

    function isValidLeaderboardEntry(data, userId) {
       return data.keys().hasAll(['userId', 'displayName', 'score', 'mode', 'timestamp']) &&
              data.keys().hasAny(['title', 'userId']) && // Dummy check just to say it might have title
              data.userId == userId &&
              data.displayName is string && data.displayName.size() <= 100 &&
              (data.keys().hasAll(['title']) ? (data.title is string && data.title.size() <= 100) : true) &&
              data.score is number && data.score >= 0 &&
              data.mode is string && data.mode.size() <= 20 &&
              data.timestamp == request.time;
    }

    function isValidChallenge(data, userId) {
       return data.keys().hasAll(['creatorId', 'creatorName', 'targetScore', 'gameMode', 'createdAt']) &&
              data.keys().size() == 5 &&
              data.creatorId == userId &&
              data.creatorName is string && data.creatorName.size() <= 100 &&
              data.targetScore is number && data.targetScore >= 0 &&
              data.gameMode is string && data.gameMode.size() <= 20 &&
              data.createdAt == request.time;
    }

    match /challenges/{challengeId} {
      allow get: if true; // Public view for shared links
      allow list: if isSignedIn() && existing().creatorId == request.auth.uid; // Only their own
      allow create: if isSignedIn() &&
                       isValidId(challengeId) &&
                       isValidChallenge(incoming(), request.auth.uid);
    }

    match /leaderboards/{mode}/entries/{entryId} {
      allow list: if true; // Public leaderboard
      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidLeaderboardEntry(incoming(), request.auth.uid) &&
                       (mode == 'endless' || mode == 'championship' || mode == 'takeover' || mode == 'quiet');
      // No updates or deletes to scores
    }

    match /multiplayer_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId);
      allow update: if isSignedIn(); // Let any player join and update their score
      allow delete: if isSignedIn() && existing().hostId == request.auth.uid;
    }

    function isValidWatercoolerChannel(data) {
       return data.keys().hasAll(['name', 'description', 'creatorId', 'createdAt']) &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 30 &&
              data.name.matches('^[a-zA-Z0-9_\\-]+$') &&
              data.description is string && data.description.size() <= 200 &&
              data.creatorId == request.auth.uid &&
              data.createdAt == request.time;
    }

    match /watercooler_channels/{channelId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(channelId) && isValidWatercoolerChannel(incoming());
      allow delete: if isOwner(existing().creatorId);
    }

    function isValidWatercoolerPost(data) {
       return data.keys().hasAll(['authorId', 'authorName', 'content', 'channel', 'upvotes', 'createdAt']) &&
              data.authorId == request.auth.uid &&
              data.authorName is string && data.authorName.size() <= 100 &&
              data.content is string && data.content.size() <= 2000 &&
              data.channel is string && data.channel.size() <= 50 &&
              data.upvotes is number && data.upvotes >= 0 &&
              data.createdAt == request.time;
    }

    match /watercooler/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidWatercoolerPost(incoming());
      allow update: if isSignedIn() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['upvotes']) &&
                    incoming().upvotes == existing().upvotes + 1;
      allow delete: if isOwner(existing().authorId);
    }

    // ----- WATERCOOLER REPLIES -----
    // Flat top-level collection (NOT a subcollection of /watercooler/*) so this
    // single allow-block governs all replies regardless of which thread they
    // belong to. Each reply doc carries a `threadId` field that the client uses
    // to filter — Firestore only sees flat docs, so default-deny doesn't trip.
    function isValidWatercoolerReply(data) {
      return data.keys().hasAll(['threadId', 'authorId', 'authorName', 'content', 'createdAt']) &&
             data.threadId is string && data.threadId.size() > 0 && data.threadId.size() <= 128 &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             (data.keys().hasAll(['mentions']) ? (data.mentions is list && data.mentions.size() <= 20) : true) &&
             data.createdAt == request.time;
    }

    match /watercooler_replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(replyId) && isValidWatercoolerReply(incoming());
      allow delete: if isOwner(existing().authorId);
      // No updates — replies are immutable once posted.
    }

    // ----- BOUNTIES -----
    match /bounties/{bountyId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && incoming().creatorId == request.auth.uid
                    && incoming().status == 'open'
                    && incoming().reward is number && incoming().reward >= 100
                    && incoming().targetScore is number && incoming().targetScore > 0
                    && incoming().expiresAt is number
                    && incoming().mode is string
                    && incoming().creatorName is string;
      // Two allowed transitions: claim (anyone signed in) or expire (creator)
      allow update: if isSignedIn() &&
                    existing().status == 'open' &&
                    (
                      // claim: anyone who is not the creator
                      (incoming().status == 'claimed'
                       && incoming().claimerId == request.auth.uid
                       && existing().creatorId != request.auth.uid
                       && incoming().diff(existing()).affectedKeys().hasOnly(['status','claimerId','claimerName']))
                      ||
                      // expire: only creator and only after expiry
                      (incoming().status == 'expired'
                       && existing().creatorId == request.auth.uid
                       && existing().expiresAt < request.time.toMillis()
                       && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
                    );
      allow delete: if false;
    }

    // ----- SEASON HALL OF FAME (immutable archive) -----
    match /seasons/{seasonDocId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && incoming().mode is string
                    && incoming().seasonId is string
                    && incoming().top is list;
      allow update, delete: if false;
    }

    // ----- COMPANIES -----
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && incoming().ownerId == request.auth.uid
                    && incoming().joinCode is string
                    && incoming().memberCount == 1
                    && incoming().name is string
                    && incoming().name.size() > 0
                    && incoming().name.size() <= 50;
      // Owner can edit metadata; anyone signed in can adjust the memberCount
      // (join/leave path) — keeps writes simple without batched transactions.
      allow update: if isSignedIn() && (
        (existing().ownerId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name','motto','joinCode','bannedIds','memberCount','channelId','channelName']))
        ||
        incoming().diff(existing()).affectedKeys().hasOnly(['memberCount'])
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /companies/{companyId}/members/{userId} {
      allow read: if true;
      // Self-join only — and only if not in the company's bannedIds
      allow create: if isOwner(userId)
                    && incoming().uid == request.auth.uid
                    && incoming().displayName is string
                    && (incoming().role == 'employee' || incoming().role == 'ceo')
                    && !get(/databases/$(database)/documents/companies/$(companyId)).data.get('bannedIds', []).hasAny([request.auth.uid]);
      allow update: if isOwner(userId)
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName','avatarId']);
      allow delete: if isOwner(userId)
                    || (isSignedIn() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid);
    }
  }
}
