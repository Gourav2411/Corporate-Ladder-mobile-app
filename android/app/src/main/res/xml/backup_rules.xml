<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (Android 6+). We exclude:
    • Firebase Auth tokens (regenerated on first launch via Google Sign-In).
    • Capacitor preferences cache (device-local, may contain Gemini API key).
  Game progress is stored server-side in Firestore — restoring local state would
  desync it. Excluding these prevents leaking secrets into a transferred device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
