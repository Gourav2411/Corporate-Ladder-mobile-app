{
  "appId": "app.corporateladder.game",
  "appName": "Corporate Ladder Simulator",
  "webDir": "dist/app-mobile/browser",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    }
  }
}
